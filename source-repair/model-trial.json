    "direct_meta": {
      "model_statements": {
        "diagnosis": "Incomplete Responses API result with incomplete_details set (content_filter or max_output_tokens) that also contains a function-call item was mapped to StopReason tool_calls, so a partial call could be dispatched and the content_filter signal plus StopDetails were lost. Separately responses_stop_details returned explanation=None when no ResponseOutputRefusal was present, which collect_stop_details then dropped as empty, leaving a content_filter stop with no visible details. Fix suppresses dispatch on any incomplete response while preserving stop signaling and refusal text, and provides a nonempty fallback explanation in the provider extractor only, leaving shared collector behavior intact.",
        "risks": [
          "Clearing tool_calls on incomplete responses discards partial args that could aid debugging.",
          "Generic 'Content was filtered' fallback has no category breakdown and may be too vague for UI.",
          "Any incomplete_details reason now suppresses tool dispatch, including future reasons where partial execution might have been desired."
        ],
        "tests_to_run": [
          "pytest tests/providers/openai/test_responses_api.py -k stop",
          "pytest tests/model/test_stop_details.py -k content_filter",
          "pytest tests/providers/openai/test_openai_responses_stop.py -k \"truncated or filtered or tool_calls\""
        ]
      },
      "patch": "diff --git a/convert_response.py b/convert_response.py\n--- a/convert_response.py\n+++ b/convert_response.py\n@@ -28,8 +28,11 @@\n     message_content, tool_calls, logprobs, has_tool_calls = (\n         _process_response_output_items(response.output, tools)\n     )\n \n-    if has_tool_calls:\n-        stop_reason = \"tool_calls\"\n+    # Suppress partial tool calls on incomplete responses so a truncated\n+    # or filtered payload is never dispatched for execution.\n+    if response.incomplete_details is not None:\n+        tool_calls = []\n+    elif has_tool_calls:\n+        stop_reason = \"tool_calls\"\n \n     return (\n         ChatMessageAssistant(\ndiff --git a/responses_stop_details.py b/responses_stop_details.py\n--- a/responses_stop_details.py\n+++ b/responses_stop_details.py\n@@ -14,6 +14,9 @@\n         and getattr(incomplete, \"reason\", None) == \"content_filter\"\n     )\n \n+    if not explanation and is_content_filter:\n+        explanation = \"Content was filtered\"\n+\n     if not explanation and not is_content_filter:\n         return None\n \n",
      "patch_sha256": "29947f398bc21f08a90ef951285eec9443549fc2a1984eb2fb055bbe375a01ba",
      "protocol": null,
      "provenance": "Direct Meta transport; executed only in the isolated sandbox after scope review.",
      "scope": {
        "approved": false,
        "reasons": [
          "Hunk context mismatch"
        ],
        "status": "rejected"
      },
      "status": "rejected",
      "supplemental": null
    },
