      "patch": "--- a/convert_response.py\n+++ b/convert_response.py\n@@ -26,13 +26,17 @@\n         _process_response_output_items(response.output, tools)\n     )\n \n-    if has_tool_calls:\n+    # An incomplete response may carry partial tool-call fragments; only a\n+    # complete response may dispatch calls or report a tool_calls stop.\n+    response_complete = response.incomplete_details is None\n+\n+    if has_tool_calls and response_complete:\n         stop_reason = \"tool_calls\"\n \n     return (\n         ChatMessageAssistant(\n             content=message_content,\n-            tool_calls=tool_calls if len(tool_calls) > 0 else None,\n+            tool_calls=(tool_calls if len(tool_calls) > 0 and response_complete else None),\n             model=model,\n             source=\"generate\",\n         ),\n--- a/responses_stop_details.py\n+++ b/responses_stop_details.py\n@@ -24,6 +24,6 @@\n \n     return StopDetails(\n         type=\"content_filter\" if is_content_filter else \"refusal\",\n-        explanation=explanation,\n+        explanation=explanation or (\"Content filtered: response incomplete\" if is_content_filter else None),\n     )\n \n",
